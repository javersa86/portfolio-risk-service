# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=risk
POSTGRES_PASSWORD=risk
POSTGRES_DB=risk

# Connection string for the API, ingestion job, and migrations.
# From your machine use localhost; from inside Docker Compose use db.
DATABASE_URL=postgresql+psycopg://risk:risk@localhost:5432/risk

# --- Market data ---
# fixture = fake test data (no key needed). Later: tiingo or alphavantage.
PRICE_PROVIDER=fixture
PRICE_PROVIDER_API_KEY=

# --- Ingestion ---
TICKERS=SPY,QQQ,AAPL,MSFT,JPM,GS,TLT,GLD